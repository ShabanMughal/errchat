{
  "name": "errchat-chat",
  "productName": "ErrChat",
  "version": "0.1.0",
  "description": "Windows chat app that uses your Claude or ChatGPT subscription through the official CLIs.",
  "author": "errchat",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "e2e": "node build.mjs && node test/e2e.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node build.mjs && electron-builder --win"
  },
  "build": {
    "appId": "com.errchat.chat",
    "productName": "ErrChat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dompurify": "^3.4.17",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}

{
  "manifest_version": 3,
  "name": "errchat",
  "version": "0.1.0",
  "description": "Reply suggestions and grammar fixes for web chats, powered by your Claude subscription.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
